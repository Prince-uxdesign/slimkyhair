# ============================================================================
# Slimky Hair — Environment Configuration (Milestone C20.9: Transactional Email)
#
# This project has no server/build step of its own — these values configure
# the Supabase Edge Functions in supabase/functions/ (set via
# `supabase secrets set`, NOT committed here) and, for the two public values,
# js/env.js on the frontend (see js/env.example.js).
#
# Never commit a real .env file or real js/env.js with production secrets.
# Placeholders below are intentionally fake — replace with real values only
# in your Supabase project's secret store / your own local .env.
# ============================================================================

# --- Resend (server-side only — set via `supabase secrets set`, never in the frontend) ---
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=orders@YOUR_VERIFIED_DOMAIN.example
RESEND_FROM_NAME="Slimky Hair"

# --- App ---
APP_URL=https://YOUR_PRODUCTION_DOMAIN.example

# --- Supabase Auth "Send Email" hook (server-side only) ---
# Generated by Supabase Dashboard -> Authentication -> Hooks when you enable
# the hook and point it at the auth-email-hook function.
SEND_EMAIL_HOOK_SECRET=whsec_YOUR_HOOK_SECRET

# --- Retry sweep authentication (server-side only) ---
CRON_SECRET=YOUR_RANDOM_CRON_SECRET

# --- Supabase (SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected
#     automatically into Edge Functions at runtime — do not set them here) ---

# --- Public, frontend-safe values (also placed in js/env.js — see js/env.example.js) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
